# Required
ANTHROPIC_API_KEY=
# Supabase Session pooler URI (...pooler.supabase.com:5432/postgres). Leave empty with --no-db.
DATABASE_URL=

# Optional (defaults shown)
CARAGENT_MODEL=claude-sonnet-5-5
# Cars refreshed per run; each costs roughly $0.30 in Claude usage.
CARAGENT_CARS_PER_RUN=6
# A car is due for a refresh once its page is this many days old.
CARAGENT_REFRESH_DAYS=28
# Web searches and page reads Claude may use per car to find critic reviews.
CARAGENT_MAX_SEARCHES=5
CARAGENT_MAX_FETCHES=6
